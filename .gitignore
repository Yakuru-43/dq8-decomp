# --- Disassembly of the game code (generated by `make setup`) ---
/asm/
/linker/
include/macro.inc

# --- Decompiled functions that are the original instructions verbatim ---
# (CodeWarrior `asm` functions for VU0 code, written by tools/autodecomp.py)
src/*/asmfunc/

# --- Build output: rebuilt game binaries, objects, maps, permuter work dirs ---
/build/
*.o
*.map
*.payload

# --- Local toolchain (proprietary CodeWarrior compiler, binutils, permuter) ---
/.toolchain/
/.venv/

# --- Scratch / caches ---
scratch/
__pycache__/
*.pyc
placeholder.txt
